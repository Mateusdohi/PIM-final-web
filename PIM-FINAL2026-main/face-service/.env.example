ENVIRONMENT=development
# Chave compartilhada com o backend C# (header X-API-Key). TROQUE em produção.
API_KEY=troque-esta-chave
# insightface (real) | mock (somente dev/testes, bloqueado em produção)
EMBEDDER=insightface
# Limiares de similaridade (cosseno) por finalidade. Calibre com dados reais!
THRESHOLD_LOGIN=0.45
THRESHOLD_PAYMENT=0.55
MIN_FACE_SIZE_PX=80
MIN_SHARPNESS=40
MAX_IMAGE_BYTES=5242880
# none | (plugue aqui um provedor de liveness; veja app/services/liveness.py)
LIVENESS_PROVIDER=none
